API_KEY=replace-with-a-long-random-secret
OCR_IMAGE=ghcr.io/faolanbig/big-batch-ocr_ocr-sequencial:v1.2.3-rc
LOG_LEVEL=INFO
ALLOW_DIRECTORY_ACCESS=false
# Compose only: replace with the numeric output of stat -c '%g' /var/run/docker.sock.
DOCKER_GID=REPLACE_WITH_DOCKER_SOCKET_GID
DATA_ROOT=/data
DOCKER_DATA_ROOT=/srv/big-batch-ocr-data
DATABASE_PATH=/var/lib/api-host/jobs.db
OCR_JOBS=3
OCR_LANGUAGE=eng
OCR_OPTIMIZE=3
MAX_CONCURRENT_JOBS=1
SYNC_WAIT_LIMIT_SECONDS=30