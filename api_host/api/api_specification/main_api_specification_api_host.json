{
  "openapi": "3.1.0",
  "info": {
    "title": "Big Batch OCR API",
    "version": "1.0.0",
    "description": "HTTP API for submitting and tracking OCR batch jobs. All input and output directory paths are relative to the API host's configured data root. The API runs the configured OCR container; callers cannot provide arbitrary mounts, Docker options, or host paths. The `/api/v1` URL prefix identifies the major API version. Backward-compatible additions remain in v1; breaking contract changes require a new major URL version."
  },
  "servers": [
    {
      "url": "/",
      "description": "The API host origin"
    }
  ],
  "tags": [
    {
      "name": "Jobs",
      "description": "OCR job submission and lifecycle"
    },
    {
      "name": "Health",
      "description": "Liveness"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    },
    {}
  ],
  "paths": {
    "/api/v1/jobs": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "operationId": "submitOcrJob",
        "summary": "Submit an OCR job",
        "description": "Submits an OCR job in the requested mode. Synchronous mode waits for the container to finish and returns the terminal result. Asynchronous mode acknowledges the job and returns a URL for polling its status. Jobs are queued when the configured concurrency limit is reached. A client disconnect or client-side timeout does not cancel an accepted job; use asynchronous mode when the client cannot wait for completion, and poll the returned status URL rather than resubmitting. If the server's synchronous wait limit is reached, it returns 504 with the accepted job ID and status URL; the job continues. Job metadata is persisted so a host restart cannot report unfinished work as successful.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitJobRequest"
              },
              "examples": {
                "synchronous": {
                  "summary": "Wait for OCR completion",
                  "value": {
                    "inputPath": "incoming/invoices",
                    "outputPath": "processed/invoices",
                    "mode": "synchronous"
                  }
                },
                "asynchronous": {
                  "summary": "Submit and poll for completion",
                  "value": {
                    "inputPath": "incoming/invoices",
                    "outputPath": "processed/invoices",
                    "mode": "asynchronous"
                  }
                },
                "createMissingDestination": {
                  "summary": "Explicitly create a missing destination directory",
                  "value": {
                    "inputPath": "incoming/invoices",
                    "outputPath": "archive/2026/invoices",
                    "mode": "asynchronous",
                    "createDestination": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synchronous job completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SynchronousJobResult"
                },
                "example": {
                  "jobId": "job_01J9M7X2K6",
                  "status": "succeeded",
                  "inputPath": "incoming/invoices",
                  "outputPath": "processed/invoices",
                  "createdAt": "2026-10-12T14:10:00Z",
                  "startedAt": "2026-10-12T14:10:01Z",
                  "completedAt": "2026-10-12T14:10:18Z",
                  "exitCode": 0,
                  "statusUrl": "/api/v1/jobs/job_01J9M7X2K6"
                }
              }
            }
          },
          "202": {
            "description": "Asynchronous job accepted. The status is a snapshot and may already be terminal by the time the response reaches the client.",
            "headers": {
              "Location": {
                "description": "URL of the job status resource.",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                },
                "example": "/api/v1/jobs/job_01J9M7X2K6"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAcknowledgement"
                },
                "example": {
                  "jobId": "job_01J9M7X2K6",
                  "status": "queued",
                  "statusUrl": "/api/v1/jobs/job_01J9M7X2K6"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/PathConflict"
          },
          "422": {
            "$ref": "#/components/responses/InvalidPath"
          },
          "500": {
            "description": "The OCR execution failed. The response identifies the failed job; its status can also be retrieved using the provided URL.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionFailure"
                },
                "example": {
                  "type": "about:blank",
                  "title": "OCR execution failed",
                  "status": 500,
                  "code": "OCR_EXECUTION_FAILED",
                  "detail": "The OCR container exited unsuccessfully.",
                  "jobId": "job_01J9M7X2K6",
                  "jobStatus": "failed",
                  "statusUrl": "/api/v1/jobs/job_01J9M7X2K6"
                }
              }
            }
          },
          "504": {
            "description": "The synchronous wait limit was reached. The accepted job continues; poll its status URL instead of submitting it again.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncWaitTimeout"
                },
                "example": {
                  "type": "about:blank",
                  "title": "Synchronous wait limit exceeded",
                  "status": 504,
                  "code": "SYNC_WAIT_TIMEOUT",
                  "detail": "The job is still running and was not cancelled.",
                  "jobId": "job_01J9M7X2K6",
                  "jobStatus": "running",
                  "statusUrl": "/api/v1/jobs/job_01J9M7X2K6"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{jobId}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "operationId": "getOcrJob",
        "summary": "Get job status",
        "description": "Returns the latest persisted state and outcome for a submitted job. A failed job is returned as a job resource with status `failed`; this is distinct from an HTTP error retrieving the resource. If the host restarts while work is unfinished, the API must not report it as successful unless completion was confirmed.",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "description": "Current job state and available completion details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                },
                "examples": {
                  "queued": {
                    "summary": "Job waiting for an available worker",
                    "value": {
                      "jobId": "job_01J9M7X2K6",
                      "status": "queued",
                      "inputPath": "incoming/invoices",
                      "outputPath": "processed/invoices",
                      "createdAt": "2026-10-12T14:10:00Z",
                      "startedAt": null,
                      "completedAt": null,
                      "exitCode": null,
                      "error": null,
                      "statusUrl": "/api/v1/jobs/job_01J9M7X2K6"
                    }
                  },
                  "running": {
                    "summary": "Job in progress",
                    "value": {
                      "jobId": "job_01J9M7X2K6",
                      "status": "running",
                      "inputPath": "incoming/invoices",
                      "outputPath": "processed/invoices",
                      "createdAt": "2026-10-12T14:10:00Z",
                      "startedAt": "2026-10-12T14:10:01Z",
                      "completedAt": null,
                      "exitCode": null,
                      "error": null,
                      "statusUrl": "/api/v1/jobs/job_01J9M7X2K6"
                    }
                  },
                  "succeeded": {
                    "summary": "Successfully completed job",
                    "value": {
                      "jobId": "job_01J9M7X2K6",
                      "status": "succeeded",
                      "inputPath": "incoming/invoices",
                      "outputPath": "processed/invoices",
                      "createdAt": "2026-10-12T14:10:00Z",
                      "startedAt": "2026-10-12T14:10:01Z",
                      "completedAt": "2026-10-12T14:10:18Z",
                      "exitCode": 0,
                      "error": null,
                      "statusUrl": "/api/v1/jobs/job_01J9M7X2K6"
                    }
                  },
                  "failed": {
                    "summary": "Job failed",
                    "value": {
                      "jobId": "job_01J9M7X2K6",
                      "status": "failed",
                      "inputPath": "incoming/invoices",
                      "outputPath": "processed/invoices",
                      "createdAt": "2026-10-12T14:10:00Z",
                      "startedAt": "2026-10-12T14:10:01Z",
                      "completedAt": "2026-10-12T14:10:18Z",
                      "exitCode": 1,
                      "error": {
                        "code": "OCR_EXECUTION_FAILED",
                        "message": "The OCR container exited unsuccessfully."
                      },
                      "statusUrl": "/api/v1/jobs/job_01J9M7X2K6"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/JobNotFound"
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getHealth",
        "summary": "Check API host liveness",
        "description": "Unauthenticated liveness endpoint. It reports whether the API process is responsive; it does not guarantee that Docker or OCR execution is available.",
        "security": [],
        "responses": {
          "200": {
            "description": "The API process is responsive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key",
        "description": "Send the configured API key as a bearer token in the Authorization header. Key-based authentication is required by default; the host must fail startup if this mode is enabled without a key. Omitting the key is accepted only when the host operator explicitly enables unauthenticated access in host configuration."
      }
    },
    "parameters": {
      "JobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "description": "Identifier returned when the job was submitted.",
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "example": "job_01J9M7X2K6"
      }
    },
    "schemas": {
      "SubmitJobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "inputPath",
          "outputPath",
          "mode"
        ],
        "properties": {
          "inputPath": {
            "type": "string",
            "minLength": 1,
            "description": "Input directory relative to the configured data root. It must resolve to an existing, readable directory."
          },
          "outputPath": {
            "type": "string",
            "minLength": 1,
            "description": "Destination directory relative to the configured data root. It must already exist unless `createDestination` is true."
          },
          "mode": {
            "type": "string",
            "enum": [
              "synchronous",
              "asynchronous"
            ],
            "description": "Synchronous mode waits for completion. Asynchronous mode returns an acknowledgement and a status URL."
          },
          "createDestination": {
            "type": "boolean",
            "default": false,
            "description": "When true, the host may create the missing destination directory, and any missing parent directories, only beneath the configured data root. When omitted or false, a missing destination is rejected."
          }
        }
      },
      "JobAcknowledgement": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jobId",
          "status",
          "statusUrl"
        ],
        "properties": {
          "jobId": {
            "type": "string",
            "description": "Stable identifier for this accepted job."
          },
          "status": {
            "$ref": "#/components/schemas/JobLifecycleStatus"
          },
          "statusUrl": {
            "type": "string",
            "format": "uri-reference",
            "description": "Relative URL to poll for the persisted job state."
          }
        }
      },
      "JobLifecycleStatus": {
        "type": "string",
        "enum": [
          "queued",
          "starting",
          "running",
          "succeeded",
          "failed"
        ],
        "description": "`succeeded` indicates successful completion; `failed` indicates execution did not complete successfully."
      },
      "JobStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jobId",
          "status",
          "inputPath",
          "outputPath",
          "createdAt",
          "startedAt",
          "completedAt",
          "exitCode",
          "error",
          "statusUrl"
        ],
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobLifecycleStatus"
          },
          "inputPath": {
            "type": "string",
            "description": "Submitted path relative to the configured data root."
          },
          "outputPath": {
            "type": "string",
            "description": "Submitted path relative to the configured data root."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Present after the job begins starting."
          },
          "completedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Present after the job reaches a terminal state."
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ],
            "description": "OCR container exit code, available when execution has finished."
          },
          "error": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/JobError"
              },
              {
                "type": "null"
              }
            ],
            "description": "Safe, client-facing failure information for a failed job; null until a failure is recorded."
          },
          "statusUrl": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      },
      "SynchronousJobResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jobId",
          "status",
          "inputPath",
          "outputPath",
          "createdAt",
          "startedAt",
          "completedAt",
          "exitCode",
          "statusUrl"
        ],
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "succeeded"
          },
          "inputPath": {
            "type": "string"
          },
          "outputPath": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "exitCode": {
            "type": "integer",
            "const": 0
          },
          "statusUrl": {
            "type": "string",
            "format": "uri-reference"
          }
        }
      },
      "JobError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "OCR_EXECUTION_FAILED"
          },
          "message": {
            "type": "string",
            "description": "Safe summary that does not expose secrets, host paths, or internal container configuration."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details with a stable API-specific code.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable API error code."
          }
        }
      },
      "ExecutionFailure": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Problem"
          },
          {
            "type": "object",
            "required": [
              "jobId",
              "jobStatus",
              "statusUrl"
            ],
            "properties": {
              "jobId": {
                "type": "string"
              },
              "jobStatus": {
                "type": "string",
                "const": "failed"
              },
              "statusUrl": {
                "type": "string",
                "format": "uri-reference"
              }
            }
          }
        ]
      },
      "SyncWaitTimeout": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Problem"
          },
          {
            "type": "object",
            "required": [
              "jobId",
              "jobStatus",
              "statusUrl"
            ],
            "properties": {
              "jobId": {
                "type": "string"
              },
              "jobStatus": {
                "type": "string",
                "enum": [
                  "queued",
                  "starting",
                  "running"
                ]
              },
              "statusUrl": {
                "type": "string",
                "format": "uri-reference"
              }
            }
          }
        ]
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed JSON or invalid request shape.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Invalid request",
              "status": 400,
              "code": "INVALID_REQUEST",
              "detail": "The request body is not valid for this operation."
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Bearer key is missing or invalid. Credentials are never returned in error responses.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Unauthorized",
              "status": 401,
              "code": "UNAUTHENTICATED",
              "detail": "A valid bearer API key is required."
            }
          }
        }
      },
      "InvalidPath": {
        "description": "A path is invalid, outside the configured data root, unreadable, or does not meet the required directory existence rules. Path validation happens before a job is started.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Invalid path",
              "status": 422,
              "code": "INVALID_PATH",
              "detail": "The input directory must be a readable directory beneath the configured data root."
            }
          }
        }
      },
      "PathConflict": {
        "description": "Input and destination resolve to the same directory or incompatible nested directories.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Incompatible directories",
              "status": 409,
              "code": "INCOMPATIBLE_PATHS",
              "detail": "Input and destination directories must be distinct and must not contain one another."
            }
          }
        }
      },
      "JobNotFound": {
        "description": "No job with this identifier is available to the authenticated caller.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            },
            "example": {
              "type": "about:blank",
              "title": "Job not found",
              "status": 404,
              "code": "JOB_NOT_FOUND",
              "detail": "No job was found for the supplied identifier."
            }
          }
        }
      }
    }
  }
}